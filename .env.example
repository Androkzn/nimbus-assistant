# Copy to .env.local and fill in at least one provider key. Keys are read only on the server.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional
# NEXT_PUBLIC_SENTRY_DSN=        # Sentry error monitoring (public send-only DSN); unset = Sentry off
# SENTRY_AUTH_TOKEN=            # build-time only: uploads source maps to Sentry (never NEXT_PUBLIC_)
# LLM_MODE=mock                 # deterministic offline model: no keys, no network (used by E2E/CI)
# ALLOW_FAULT_INJECTION=1       # enable #fail-primary / #fail-midstream / #rate-limit-all / #auth-primary fault markers
# RATE_LIMIT_MAX=20             # questions per 5 minutes per IP (raise locally, e.g. 200, so testing doesn't lock you out)
# EVAL_BYPASS_TOKEN=            # lets `npm run eval:live` bypass the rate limiter (send as x-eval-token)
# GOOGLE_DRIVE_FOLDER_ID=1jZtIbeRwf58SPUkJxUkht_M8Os4UBlF6
# GOOGLE_DRIVE_ACCESS_TOKEN=    # short-lived local/test token; do not commit
# GOOGLE_DRIVE_REFRESH_TOKEN=   # CI/local OAuth refresh token; prefer macOS Keychain locally
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_KEYCHAIN_SERVICE=nimbus-assistant-google-drive
# GOOGLE_DRIVE_REQUIRED=1       # fail a deployment build instead of using the checked-in fallback
# GOOGLE_DRIVE_FINDINGS_ENABLED=0 # set to 1 only with a write-capable Drive OAuth grant
# GOOGLE_DRIVE_FINDINGS_FOLDER_ID=1iVRPfxJB5lHc6TorqWnmC5IeW5kY_a0s # 04-improvement-findings
