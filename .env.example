# Copy to .env.local and fill in at least one provider key. Keys are read only on the server.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional
# NEXT_PUBLIC_SENTRY_DSN=        # Sentry error monitoring (public send-only DSN); unset = Sentry off
# SENTRY_AUTH_TOKEN=            # build-time only: uploads source maps to Sentry (never NEXT_PUBLIC_)
# LLM_MODE=mock                 # deterministic offline model: no keys, no network (used by E2E/CI)
# ALLOW_FAULT_INJECTION=1       # enable #fail-primary / #fail-midstream / #rate-limit-all / #auth-primary fault markers
# RATE_LIMIT_MAX=20             # questions per 5 minutes per IP (raise locally, e.g. 200, so testing doesn't lock you out)
# EVAL_BYPASS_TOKEN=            # lets `npm run eval:live` bypass the rate limiter (send as x-eval-token)
# DATABASE_URL=                 # shared Postgres URL for Vercel Production and Preview
# POSTGRES_URL=                 # accepted alias used by some Vercel Marketplace providers
# NIMBUS_KB_DB_PATH=.data/nimbus-kb.sqlite # optional; defaults to .data/nimbus-kb.sqlite locally
